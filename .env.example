# OpenClaw Environment — copy to .env and fill in values
# NEVER commit .env

# Anthropic API key (required for OpenClaw)
ANTHROPIC_API_KEY=your_key_here

# Hostinger VPS details
VPS_HOST=your.vps.ip
VPS_USER=root
VPS_PORT=22

# OpenClaw gateway
OPENCLAW_PORT=18789
OPENCLAW_GATEWAY_URL=http://${VPS_HOST}:${OPENCLAW_PORT}
